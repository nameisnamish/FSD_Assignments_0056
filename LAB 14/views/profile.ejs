<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= user.firstName %> <%= user.lastName %> - User Profile</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    body {
      background-color: #f4f6f9;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }
    .profile-header-card {
      background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
      color: white;
      border-radius: 16px;
      padding: 30px;
      box-shadow: 0 8px 24px rgba(30, 60, 114, 0.18);
    }
    .avatar-circle {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.2);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2rem;
      font-weight: 700;
      color: #fff;
      border: 3px solid rgba(255, 255, 255, 0.4);
    }
    .card {
      border: none;
      border-radius: 14px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
    }
    .child-card {
      transition: transform 0.15s ease, box-shadow 0.15s ease;
      border: 1px solid #e9ecef;
    }
    .child-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
    }
    .badge-count {
      background-color: #e3f2fd;
      color: #0d6efd;
      font-size: 0.9rem;
      padding: 6px 14px;
      border-radius: 20px;
      font-weight: 600;
    }
  </style>
</head>
<body>
  <!-- Navigation Bar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4 shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/users">
        <i class="bi bi-people-fill me-2"></i>Family Management
      </a>
      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/users"><i class="bi bi-arrow-left me-1"></i> All Users</a>
      </div>
    </div>
  </nav>

  <div class="container pb-5">
    <!-- User Profile Card -->
    <div class="profile-header-card mb-4">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
          <div class="avatar-circle">
            <%= user.firstName.charAt(0).toUpperCase() %>
          </div>
          <div>
            <h1 class="h3 mb-1 fw-bold"><%= user.firstName %> <%= user.lastName %></h1>
            <div class="d-flex flex-wrap gap-3 mt-2 text-white-50">
              <span><i class="bi bi-envelope-fill me-1 text-white"></i> <%= user.email %></span>
              <span><i class="bi bi-telephone-fill me-1 text-white"></i> <%= user.phone || 'No phone provided' %></span>
              <span><i class="bi bi-key-fill me-1 text-white"></i> ID: <code class="text-white"><%= user._id %></code></span>
            </div>
          </div>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <a href="/users/<%= user._id %>/add-child" class="btn btn-light fw-semibold">
            <i class="bi bi-person-plus-fill me-1 text-primary"></i> Add Child
          </a>
          <a href="/users/<%= user._id %>/children/count" class="btn btn-outline-light" target="_blank">
            <i class="bi bi-hash me-1"></i> Child Count API
          </a>
          <form action="/users/<%= user._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this user profile and all their children?');" style="display:inline;">
            <input type="hidden" name="_method" value="DELETE">
            <button type="submit" class="btn btn-danger">
              <i class="bi bi-trash me-1"></i> Delete User
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- Children List Section -->
    <div class="card mb-4">
      <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
        <h2 class="h5 mb-0 fw-bold text-dark">
          <i class="bi bi-person-badge-fill me-2 text-primary"></i>Children of <%= user.firstName %>
        </h2>
        <span class="badge-count">
          <%= children.length %> <%= children.length === 1 ? 'Child' : 'Children' %>
        </span>
      </div>
      <div class="card-body p-4">
        <% if (!children || children.length === 0) { %>
          <div class="alert alert-info py-4 text-center my-2" role="alert">
            <i class="bi bi-info-circle-fill fs-3 d-block mb-2 text-primary"></i>
            <h5 class="alert-heading fw-bold">No children found for this user.</h5>
            <p class="mb-3 text-muted">Use the button below to add the first child to this profile.</p>
            <a href="/users/<%= user._id %>/add-child" class="btn btn-sm btn-primary">
              <i class="bi bi-plus-circle me-1"></i> Add Child Now
            </a>
          </div>
        <% } else { %>
          <div class="row g-3">
            <% children.forEach(child => { %>
              <div class="col-md-6 col-lg-4">
                <div class="card h-100 child-card p-3">
                  <div class="d-flex justify-content-between align-items-start mb-2">
                    <h5 class="card-title fw-bold text-dark mb-0">
                      <%= child.firstName %> <%= child.lastName %>
                    </h5>
                    <span class="badge bg-primary-subtle text-primary fw-semibold px-2 py-1">
                      Age: <%= child.age %>
                    </span>
                  </div>
                  
                  <p class="text-muted small mb-3">
                    <i class="bi bi-envelope me-1"></i> <%= child.email || 'No email provided' %>
                  </p>

                  <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                    <a href="/users/<%= user._id %>/children/<%= child._id %>" class="btn btn-sm btn-outline-primary" title="View Child Details">
                      <i class="bi bi-eye"></i> View
                    </a>
                    <div class="btn-group">
                      <a href="/children/<%= child._id %>/edit" class="btn btn-sm btn-outline-secondary" title="Update Child">
                        <i class="bi bi-pencil-square"></i> Edit
                      </a>
                      <form action="/children/<%= child._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this child?');" style="display:inline;">
                        <input type="hidden" name="_method" value="DELETE">
                        <input type="hidden" name="parentId" value="<%= user._id %>">
                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Child">
                          <i class="bi bi-trash"></i> Delete
                        </button>
                      </form>
                    </div>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Quick Add Child Form Option on Profile Page -->
    <div class="card">
      <div class="card-header bg-white py-3 border-bottom">
        <h3 class="h5 mb-0 fw-bold text-dark">
          <i class="bi bi-plus-circle-fill me-2 text-success"></i>Quick Add Child
        </h3>
      </div>
      <div class="card-body p-4">
        <form action="/users/<%= user._id %>/children" method="POST" class="row g-3">
          <div class="col-md-3">
            <label class="form-label fw-semibold">First Name <span class="text-danger">*</span></label>
            <input type="text" name="firstName" class="form-control" placeholder="e.g. Leo" required>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-semibold">Last Name</label>
            <input type="text" name="lastName" class="form-control" placeholder="e.g. <%= user.lastName || 'Smith' %>">
          </div>
          <div class="col-md-2">
            <label class="form-label fw-semibold">Age <span class="text-danger">*</span></label>
            <input type="number" name="age" class="form-control" min="0" max="120" placeholder="e.g. 7" required>
          </div>
          <div class="col-md-4">
            <label class="form-label fw-semibold">Email</label>
            <input type="email" name="email" class="form-control" placeholder="child@example.com">
          </div>
          <div class="col-12 text-end">
            <button type="submit" class="btn btn-success px-4">
              <i class="bi bi-person-check-fill me-1"></i> Add Child to Profile
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</body>
</html>
