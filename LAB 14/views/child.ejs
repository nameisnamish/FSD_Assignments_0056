<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= child.firstName %> <%= child.lastName %> - Child Details</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    body {
      background-color: #f4f6f9;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }
    .card {
      border: none;
      border-radius: 14px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
    }
    .verified-banner {
      background-color: #e8f5e9;
      color: #2e7d32;
      border: 1px solid #c8e6c9;
      border-radius: 10px;
      padding: 12px 18px;
    }
  </style>
</head>
<body>
  <!-- Navigation -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4 shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/users">
        <i class="bi bi-people-fill me-2"></i>Family Management
      </a>
      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/users/<%= user._id %>">
          <i class="bi bi-arrow-left me-1"></i> Back to <%= user.firstName %>'s Profile
        </a>
      </div>
    </div>
  </nav>

  <div class="container py-4" style="max-width: 720px;">
    <!-- Relationship verification banner for Thinking Challenge -->
    <div class="verified-banner mb-4 d-flex align-items-center">
      <i class="bi bi-shield-check fs-3 me-3"></i>
      <div>
        <div class="fw-bold">Parent-Child Relationship Verified</div>
        <div class="small">This child is confirmed to belong to <strong><%= user.firstName %> <%= user.lastName %></strong> (Parent ID: <code><%= user._id %></code>).</div>
      </div>
    </div>

    <div class="card p-4">
      <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-3">
        <div>
          <h2 class="h3 fw-bold text-dark mb-1"><%= child.firstName %> <%= child.lastName %></h2>
          <span class="badge bg-primary px-3 py-2 fs-6">Age: <%= child.age %> years old</span>
        </div>
        <div class="btn-group">
          <a href="/children/<%= child._id %>/edit" class="btn btn-outline-secondary">
            <i class="bi bi-pencil-square me-1"></i> Edit
          </a>
          <form action="/children/<%= child._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this child?');" style="display:inline;">
            <input type="hidden" name="_method" value="DELETE">
            <input type="hidden" name="parentId" value="<%= user._id %>">
            <button type="submit" class="btn btn-outline-danger">
              <i class="bi bi-trash me-1"></i> Delete
            </button>
          </form>
        </div>
      </div>

      <div class="row g-3 mb-4">
        <div class="col-sm-6">
          <div class="text-muted small fw-semibold">CHILD EMAIL</div>
          <div class="fs-6 fw-medium"><%= child.email || 'None' %></div>
        </div>
        <div class="col-sm-6">
          <div class="text-muted small fw-semibold">CHILD ID</div>
          <div class="fs-6 font-monospace text-secondary"><%= child._id %></div>
        </div>
      </div>

      <div class="p-3 bg-light rounded-3 mb-4 border">
        <h5 class="fw-bold h6 text-secondary text-uppercase mb-2">Parent Details</h5>
        <div class="row g-2">
          <div class="col-sm-6">
            <span class="text-muted">Parent Name:</span>
            <span class="fw-semibold ms-1"><%= user.firstName %> <%= user.lastName %></span>
          </div>
          <div class="col-sm-6">
            <span class="text-muted">Parent Email:</span>
            <span class="fw-semibold ms-1"><%= user.email %></span>
          </div>
          <div class="col-12">
            <span class="text-muted">Parent ID:</span>
            <span class="font-monospace ms-1 small"><%= user._id %></span>
          </div>
        </div>
      </div>

      <div class="d-flex justify-content-between">
        <a href="/users/<%= user._id %>" class="btn btn-secondary">
          <i class="bi bi-arrow-left me-1"></i> Return to Profile
        </a>
      </div>
    </div>
  </div>
</body>
</html>
