<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit <%= child.firstName %> - Child Details</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    body {
      background-color: #f4f6f9;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }
    .card {
      border: none;
      border-radius: 14px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
    }
  </style>
</head>
<body>
  <!-- Navigation -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4 shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/users">
        <i class="bi bi-people-fill me-2"></i>Family Management
      </a>
      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/users/<%= child.parentId %>">
          <i class="bi bi-arrow-left me-1"></i> Back to Parent Profile
        </a>
      </div>
    </div>
  </nav>

  <div class="container py-4" style="max-width: 600px;">
    <div class="card p-4">
      <div class="mb-4 text-center">
        <div class="d-inline-flex p-3 rounded-circle bg-warning-subtle text-warning-emphasis mb-2">
          <i class="bi bi-pencil-square fs-2"></i>
        </div>
        <h2 class="h4 fw-bold">Update Child Details</h2>
        <p class="text-muted">Child ID: <code><%= child._id %></code></p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger" role="alert">
          <i class="bi bi-exclamation-circle-fill me-2"></i><%= error %>
        </div>
      <% } %>

      <!-- Uses method-override with _method=PATCH -->
      <form action="/children/<%= child._id %>" method="POST">
        <input type="hidden" name="_method" value="PATCH">
        <div class="mb-3">
          <label class="form-label fw-semibold">First Name <span class="text-danger">*</span></label>
          <input type="text" name="firstName" class="form-control" value="<%= child.firstName %>" required>
        </div>

        <div class="mb-3">
          <label class="form-label fw-semibold">Last Name</label>
          <input type="text" name="lastName" class="form-control" value="<%= child.lastName || '' %>">
        </div>

        <div class="mb-3">
          <label class="form-label fw-semibold">Age <span class="text-danger">*</span></label>
          <input type="number" name="age" class="form-control" min="0" max="120" value="<%= child.age %>" required>
        </div>

        <div class="mb-4">
          <label class="form-label fw-semibold">Email</label>
          <input type="email" name="email" class="form-control" value="<%= child.email || '' %>">
        </div>

        <div class="d-grid gap-2">
          <button type="submit" class="btn btn-primary py-2 fw-semibold">
            <i class="bi bi-save me-1"></i> Save Changes (PATCH)
          </button>
          <a href="/users/<%= child.parentId %>" class="btn btn-outline-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</body>
</html>
