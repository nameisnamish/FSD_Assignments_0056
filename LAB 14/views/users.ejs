<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User & Family Management System</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    body {
      background-color: #f4f6f9;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }
    .card {
      border: none;
      border-radius: 14px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
    }
    .user-table th {
      background-color: #f8f9fa;
      font-weight: 600;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #6c757d;
    }
    .user-row:hover {
      background-color: #f8faff;
    }
    .avatar-sm {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: #0d6efd;
      color: white;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 600;
      font-size: 0.95rem;
    }
  </style>
</head>
<body>
  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4 shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/users">
        <i class="bi bi-people-fill me-2"></i>Mini User & Family Management System
      </a>
    </div>
  </nav>

  <div class="container pb-5">
    <!-- Header Hero -->
    <div class="row align-items-center mb-4">
      <div class="col-md-7">
        <h1 class="h2 fw-bold text-dark mb-1">User Directory</h1>
        <p class="text-muted mb-0">Manage users and their family child relationships.</p>
      </div>
      <div class="col-md-5">
        <!-- Search Form (GET /users/search/:name) -->
        <form onsubmit="event.preventDefault(); const val = document.getElementById('searchInput').value.trim(); if(val) { window.location.href = '/users/search/' + encodeURIComponent(val); } else { window.location.href = '/users'; }" class="d-flex gap-2">
          <div class="input-group">
            <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
            <input type="text" id="searchInput" class="form-control" placeholder="Search by first name..." value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
            <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
              <a href="/users" class="btn btn-outline-secondary" title="Clear Search">
                <i class="bi bi-x-lg"></i>
              </a>
            <% } %>
            <button class="btn btn-primary" type="submit">Search</button>
          </div>
        </form>
      </div>
    </div>

    <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
      <div class="alert alert-secondary d-flex justify-content-between align-items-center mb-4">
        <span>Showing search results for: <strong>"<%= searchQuery %>"</strong></span>
        <a href="/users" class="text-decoration-none small fw-semibold"><i class="bi bi-arrow-left"></i> View All Users</a>
      </div>
    <% } %>

    <div class="row g-4">
      <!-- Create New User Form -->
      <div class="col-lg-4">
        <div class="card p-4 h-100">
          <h2 class="h5 fw-bold text-dark mb-3">
            <i class="bi bi-person-plus-fill me-2 text-primary"></i>Create New User
          </h2>
          <form action="/users" method="POST">
            <div class="mb-3">
              <label class="form-label fw-semibold small">First Name <span class="text-danger">*</span></label>
              <input type="text" name="firstName" class="form-control" placeholder="e.g. Alex" required>
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold small">Last Name</label>
              <input type="text" name="lastName" class="form-control" placeholder="e.g. Smith">
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold small">Email <span class="text-danger">*</span></label>
              <input type="email" name="email" class="form-control" placeholder="alex.smith@example.com" required>
            </div>
            <div class="mb-4">
              <label class="form-label fw-semibold small">Phone</label>
              <input type="tel" name="phone" class="form-control" placeholder="9876543210">
            </div>
            <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
              <i class="bi bi-check-lg me-1"></i> Register User (POST /users)
            </button>
          </form>
        </div>
      </div>

      <!-- Users Table / List -->
      <div class="col-lg-8">
        <div class="card">
          <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
            <h2 class="h5 mb-0 fw-bold text-dark">
              <i class="bi bi-list-ul me-2 text-secondary"></i>Registered Users (<%= users.length %>)
            </h2>
          </div>
          <div class="card-body p-0">
            <% if (!users || users.length === 0) { %>
              <div class="p-5 text-center text-muted">
                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                <p class="mb-0">No users found. Use the form on the left to create the first user!</p>
              </div>
            <% } else { %>
              <div class="table-responsive">
                <table class="table user-table align-middle mb-0">
                  <thead>
                    <tr>
                      <th class="ps-4">User</th>
                      <th>Email</th>
                      <th>Phone</th>
                      <th>Children</th>
                      <th class="text-end pe-4">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% users.forEach(u => { %>
                      <tr class="user-row">
                        <td class="ps-4">
                          <div class="d-flex align-items-center gap-2">
                            <div class="avatar-sm">
                              <%= u.firstName ? u.firstName.charAt(0).toUpperCase() : 'U' %>
                            </div>
                            <div>
                              <div class="fw-bold text-dark"><%= u.firstName %> <%= u.lastName %></div>
                              <small class="text-muted font-monospace"><%= u._id %></small>
                            </div>
                          </div>
                        </td>
                        <td><%= u.email %></td>
                        <td><%= u.phone || '-' %></td>
                        <td>
                          <span class="badge bg-secondary-subtle text-secondary-emphasis">
                            <%= typeof u.childCount !== 'undefined' ? u.childCount : (childCountMap && childCountMap[u._id.toString()] ? childCountMap[u._id.toString()] : 0) %>
                          </span>
                        </td>
                        <td class="text-end pe-4">
                          <div class="d-inline-flex gap-1">
                            <a href="/users/<%= u._id %>" class="btn btn-sm btn-primary">
                              <i class="bi bi-arrow-right-circle me-1"></i> View Profile
                            </a>
                            <form action="/users/<%= u._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this user and all their children?');" style="display:inline;">
                              <input type="hidden" name="_method" value="DELETE">
                              <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete User">
                                <i class="bi bi-trash"></i>
                              </button>
                            </form>
                          </div>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
