<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add Child to <%= user.firstName %> <%= user.lastName %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    body {
      background-color: #f4f6f9;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }
    .card {
      border: none;
      border-radius: 14px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
    }
  </style>
</head>
<body>
  <!-- Navigation -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4 shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/users">
        <i class="bi bi-people-fill me-2"></i>Family Management
      </a>
      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/users/<%= user._id %>">
          <i class="bi bi-arrow-left me-1"></i> Back to Profile
        </a>
      </div>
    </div>
  </nav>

  <div class="container py-4" style="max-width: 600px;">
    <div class="card p-4">
      <div class="mb-4 text-center">
        <div class="d-inline-flex p-3 rounded-circle bg-primary-subtle text-primary mb-2">
          <i class="bi bi-person-plus-fill fs-2"></i>
        </div>
        <h2 class="h4 fw-bold">Add Child</h2>
        <p class="text-muted">Parent: <strong><%= user.firstName %> <%= user.lastName %></strong> (<%= user.email %>)</p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger" role="alert">
          <i class="bi bi-exclamation-circle-fill me-2"></i><%= error %>
        </div>
      <% } %>

      <form action="/users/<%= user._id %>/children" method="POST">
        <div class="mb-3">
          <label class="form-label fw-semibold">First Name <span class="text-danger">*</span></label>
          <input type="text" name="firstName" class="form-control" placeholder="e.g. Leo" required autofocus>
        </div>

        <div class="mb-3">
          <label class="form-label fw-semibold">Last Name</label>
          <input type="text" name="lastName" class="form-control" placeholder="e.g. <%= user.lastName || 'Smith' %>">
        </div>

        <div class="mb-3">
          <label class="form-label fw-semibold">Age <span class="text-danger">*</span></label>
          <input type="number" name="age" class="form-control" min="0" max="120" placeholder="e.g. 7" required>
        </div>

        <div class="mb-4">
          <label class="form-label fw-semibold">Child Email (Optional)</label>
          <input type="email" name="email" class="form-control" placeholder="child@example.com">
        </div>

        <div class="d-grid gap-2">
          <button type="submit" class="btn btn-success py-2 fw-semibold">
            <i class="bi bi-check-circle me-1"></i> Save Child
          </button>
          <a href="/users/<%= user._id %>" class="btn btn-outline-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</body>
</html>
