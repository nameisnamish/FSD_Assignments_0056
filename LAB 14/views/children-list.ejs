<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Children of <%= user.firstName %> <%= user.lastName %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    body {
      background-color: #f4f6f9;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }
    .card {
      border: none;
      border-radius: 14px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
    }
  </style>
</head>
<body>
  <!-- Navigation -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4 shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/users">
        <i class="bi bi-people-fill me-2"></i>Family Management
      </a>
      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/users/<%= user._id %>">
          <i class="bi bi-person-fill me-1"></i> User Profile
        </a>
      </div>
    </div>
  </nav>

  <div class="container py-4" style="max-width: 800px;">
    <div class="card p-4">
      <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
        <div>
          <h1 class="h3 fw-bold mb-1">Children of <%= user.firstName %> <%= user.lastName %></h1>
          <p class="text-muted mb-0">Parent ID: <code><%= user._id %></code></p>
        </div>
        <a href="/users/<%= user._id %>/add-child" class="btn btn-primary">
          <i class="bi bi-plus-lg me-1"></i> Add Child
        </a>
      </div>

      <% if (!children || children.length === 0) { %>
        <div class="alert alert-info text-center py-4 my-3">
          <i class="bi bi-info-circle fs-3 d-block mb-2"></i>
          <h5 class="fw-bold">No children found for this user.</h5>
          <p class="text-muted mb-3">This user has not registered any children yet.</p>
          <a href="/users/<%= user._id %>/add-child" class="btn btn-sm btn-primary">Add Child</a>
        </div>
      <% } else { %>
        <div class="list-group mb-4">
          <% children.forEach(child => { %>
            <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-3">
              <div>
                <h5 class="mb-1 fw-bold text-dark"><%= child.firstName %> <%= child.lastName %></h5>
                <div class="text-muted small">
                  <span class="me-3"><i class="bi bi-calendar3 me-1"></i> Age: <strong><%= child.age %></strong></span>
                  <span><i class="bi bi-envelope me-1"></i> <%= child.email || 'No email' %></span>
                </div>
              </div>
              <div class="d-flex gap-2">
                <a href="/users/<%= user._id %>/children/<%= child._id %>" class="btn btn-sm btn-outline-primary">
                  View
                </a>
                <a href="/children/<%= child._id %>/edit" class="btn btn-sm btn-outline-secondary">
                  Edit
                </a>
                <form action="/children/<%= child._id %>" method="POST" onsubmit="return confirm('Delete this child?');" style="display:inline;">
                  <input type="hidden" name="_method" value="DELETE">
                  <button type="submit" class="btn btn-sm btn-outline-danger">
                    Delete
                  </button>
                </form>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>

      <div>
        <a href="/users/<%= user._id %>" class="btn btn-secondary">
          <i class="bi bi-arrow-left me-1"></i> Return to Profile
        </a>
      </div>
    </div>
  </div>
</body>
</html>
